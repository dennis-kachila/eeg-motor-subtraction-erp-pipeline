[build-system]
requires = ["setuptools", "build", "numpy"]
build-backend = "setuptools.build_meta"

# ----> DO NOT EDIT pyproject.toml, it's autogenerated from pyproject.toml.in <----- #

[project]
name = "Biosig"  # as it would appear on PyPI
version = '@PACKAGE_VERSION@'
description = 'BioSig - tools for biomedical signal processing'
readme = "README.md"
authors = [
	{name = "Alois Schlögl", email = "alois.schloegl@gmail.com"},
	]
maintainers=[
	{name = "Alois Schlögl", email = "alois.schloegl@gmail.com"},
	]
keywords = ['EEG', 'ECG', 'EKG', 'EMG', 'EOG', 'Polysomnography', 'ECoG', 'biomedical signals', 'SCP', 'EDF', 'GDF', 'HEKA', 'CFS', 'ABF']
license = "GPL-3.0-only"
dependencies = ['numpy']
classifiers = [
	'Programming Language :: Python',
	'Operating System :: OS Independent'
]
#	Entry points
#	optional-dependencies
#	dynamic

[project.urls]
Homepage      = "https://biosig.sourceforge.io"
Documentation = "https://sourceforge.net/p/biosig/wiki/Home/"
Repository    = "https://git.code.sf.net/p/biosig/code"
# Issues      = "https://github.com/me/spam/issues"
Changelog     = "https://pub.ista.ac.at/~schloegl/biosig/RELEASE-NOTES"

